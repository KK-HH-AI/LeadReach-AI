// 前端流水线（方案 A）：打包 dist → 拷入 nginx 挂载目录 → nginx 容器即时生效
// 部署目标：/var/www/nginx/html 已挂载到宿主机 /home/xike/LeadReach_AI/nginx/html
// 说明：本 Job 只服务于 frontend，不做 changeset 过滤
pipeline {
    agent any

    triggers { pollSCM('H 12 * * *') }

    environment {
        // Jenkins 容器内 workspace 对应宿主机路径（jenkins/home bind mount）
        HOST_WS = "/home/xike/LeadReach_AI/jenkins/home/workspace/${JOB_NAME}"
    }

    stages {
        // 构建：用 node 容器执行 pnpm build
        // 注意：挂载的是【宿主机路径】，因为 jenkins 调用的 docker 是宿主机 docker
        stage('构建 dist') {
            steps {
                sh '''
                    docker run --rm \
                        -v "${HOST_WS}/frontend":/app \
                        -w /app \
                        node:20-alpine \
                        sh -c "corepack enable && corepack prepare pnpm@10.18.1 --activate && pnpm install --frozen-lockfile && pnpm build"
                '''
            }
        }

        // 部署：把 dist 拷到 nginx 挂载目录（Jenkins 容器内 /var/www/nginx/html = 宿主机 nginx/html）
        stage('部署到 nginx') {
            steps {
                sh '''
                    mkdir -p /var/www/nginx/html
                    cp -rf "${WORKSPACE}/frontend/dist/." /var/www/nginx/html/
                    echo "前端已部署到 /var/www/nginx/html"
                '''
            }
        }
    }
}