// 网关流水线：只负责 gateway-service/ 目录，构建 Go 镜像并部署
// 触发：每天 12 点那一小时内轮询 GitHub；H 让 Jenkins 自动错开各 Job 的分钟，避免整点挤一起
// 变更过滤：首构(BUILD_NUMBER==1)或改动 gateway-service/ 时才执行
pipeline {
    agent any

    triggers { pollSCM('H 12 * * *') }

    stages {
        stage('构建镜像') {
            when {
                anyOf {
                    changeset 'gateway-service/**'
                    expression { return env.BUILD_NUMBER == '1' }
                }
            }
            steps {
                dir('gateway-service') {
                    sh 'docker build -t leadreach/gateway:latest .'
                }
            }
        }

        stage('部署') {
            when {
                anyOf {
                    changeset 'gateway-service/**'
                    expression { return env.BUILD_NUMBER == '1' }
                }
            }
            steps {
                sh '''
                    cd ${WORKSPACE}
                    docker compose up -d --no-deps --no-build gateway
                '''
            }
        }
    }
}